# ── App ───────────────────────────────────────────────
ENVIRONMENT=development
APP_VERSION=0.1.0

# ── Database ──────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/engagement_db

# ── AI ────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o

# ── Auth ──────────────────────────────────────────────
JWT_SECRET=change-me-use-32-or-more-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ENCRYPTION_KEY=change-me-32-bytes-base64-encoded==

# ── Vector DB ─────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma

# ── Redis ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Frontend ──────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
FRONTEND_URL=http://localhost:3000

# ── CORS ──────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000"]

# ── Email (Resend or SendGrid) ────────────────────────
EMAIL_PROVIDER=resend
EMAIL_API_KEY=re_...
EMAIL_FROM=noreply@yourdomain.com

# ── Calendar Integrations ─────────────────────────────
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google-calendar/callback

CALENDLY_API_KEY=

# ── Messaging Channels ────────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=change-me-random-string

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=change-me-random-string

# ── Stripe ────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_STARTER=price_...
STRIPE_PRICE_ID_PRO=price_...

# ── Monitoring ────────────────────────────────────────
SENTRY_DSN=
